[Unit]
Description=Čierne diery web server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/ciernediery
ExecStart=/opt/ciernediery/venv/bin/python server.py
Restart=on-failure
RestartSec=5
EnvironmentFile=-/opt/ciernediery/.env
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
